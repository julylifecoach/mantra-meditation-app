generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  googleId             String?           @unique
  email                String            @unique
  displayName          String
  nickname             String?
  passwordHash         String?
  role                 String            @default("user")
  canWrite             Boolean           @default(true)
  agreedToTos          Boolean           @default(false)
  tosAgreedAt          DateTime?
  marketingOptIn       Boolean           @default(false)
  
  // Ecosystem Permissions
  accessSelfCoaching   Boolean           @default(false)
  accessContentCreator Boolean           @default(false)
  accessClientPortal   Boolean           @default(false)
  accessBizCoach       Boolean           @default(false)
  accessPracticeKit    Boolean           @default(false)

  // Client Portal Content
  primaryNotes         String?
  playlistUrl          String?

  reflections          Reflection[]
  subscription         Subscription?
  resilienceScores     ResilienceScore[]
  coachingSessions     CoachingSession[]
  enrollments          Enrollment[]
  plannerTasks         PlannerTask[]
  kitProgress          KitProgress[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  stripeCustomerId String    @unique
  stripeSubId      String?   @unique
  status           String    @default("none")
  plan             String?
  currentPeriodEnd DateTime?
  trialEnd         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Reflection {
  id        String   @id @default(uuid())
  title     String?
  content   String
  isPublic  Boolean  @default(false)
  mantra    String?
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Mantra {
  id        String   @id @default(uuid())
  text      String
  category  String
}

model ResilienceScore {
  id          String   @id @default(uuid())
  totalScore  Int
  maxScore    Int
  verdict     String
  categories  Json
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model CoachingSession {
  id          String   @id @default(uuid())
  sessionDate DateTime
  mainTopics  String
  recordNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Program {
  id                  String       @id @default(uuid())
  slug                String       @unique
  title               String
  description         String?
  materials           String?
  playlistId          String?
  includedForBizCoach Boolean      @default(true)
  isPublic            Boolean      @default(false)
  active              Boolean      @default(true)
  startDate           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  enrollments         Enrollment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  programId String
  user      User     @relation(fields: [userId], references: [id])
  program   Program  @relation(fields: [programId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, programId])
}

model PlannerTask {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  category    String?
  priority    Int      @default(2)
  storyPoints Int      @default(0)
  done        Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuizResult {
  id        String   @id @default(uuid())
  quizName  String   // 'ego_check', 'resilience', 'nlp_submodality'
  answers   Json     // raw per-question answers
  scores    Json     // computed scores (total, sections, topics, categories)
  verdict   String?  // verdict text
  metadata  Json?    // any extra data (language for NLP quiz, etc.)
  createdAt DateTime @default(now())

  @@index([quizName])
  @@index([createdAt])
}

model KitProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  toolKey   String   // 'heart-opening-108', 'listening-lens', 'side-effect-quests-v2', 'sa-practice-kit-workbook'
  data      Json     // the full localStorage JSON blob for that tool
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, toolKey])
  @@index([userId])
}

model AskQuestion {
  id              String    @id @default(uuid())
  name            String
  email           String
  question        String
  context         String?
  answer          String?
  status          String    @default("pending") // pending | published
  subscribedToKit Boolean   @default(false)
  answeredAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}
