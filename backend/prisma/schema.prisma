generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(uuid())
  googleId             String?           @unique
  email                String            @unique
  displayName          String
  nickname             String?
  passwordHash         String?
  role                 String            @default("user")
  canWrite             Boolean           @default(true)
  agreedToTos          Boolean           @default(false)
  tosAgreedAt          DateTime?
  marketingOptIn       Boolean           @default(false)
  
  // Ecosystem Permissions
  accessSelfCoaching   Boolean           @default(false)
  accessContentCreator Boolean           @default(false)
  accessClientPortal   Boolean           @default(false)
  accessBizCoach       Boolean           @default(false)

  reflections          Reflection[]
  subscription         Subscription?
  resilienceScores     ResilienceScore[]
  coachingSessions     CoachingSession[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  stripeCustomerId String    @unique
  stripeSubId      String?   @unique
  status           String    @default("none")
  plan             String?
  currentPeriodEnd DateTime?
  trialEnd         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Reflection {
  id        String   @id @default(uuid())
  title     String?
  content   String
  isPublic  Boolean  @default(false)
  mantra    String?
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Mantra {
  id        String   @id @default(uuid())
  text      String
  category  String
}

model ResilienceScore {
  id          String   @id @default(uuid())
  totalScore  Int
  maxScore    Int
  verdict     String
  categories  Json
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model CoachingSession {
  id          String   @id @default(uuid())
  sessionDate DateTime
  mainTopics  String
  recordNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
